model League {
  id               String   @id @default(uuid())
  externalId       Int      @unique @map("external_id")
  name             String
  country          String
  logo             String?
  type             String // "League" | "Cup" | "Tournament"
  seasonStartMonth Int      @map("season_start_month")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  seasons LeagueSeason[]

  @@map("leagues")
}

model LeagueSeason {
  id        String   @id @default(uuid())
  leagueId  String   @map("league_id")
  year      Int
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  league League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  LeagueSeasonTeam[]

  @@unique([leagueId, year])
  @@index([leagueId])
  @@map("league_seasons")
}

/**
 * Which clubs play in a league season. Clubs move between leagues year to year,
 * so the link is per season rather than per league. Populated by the squad sync;
 * lets anything that needs a league-correct player pool resolve one locally.
 */
model LeagueSeasonTeam {
  id             String   @id @default(uuid())
  leagueSeasonId String   @map("league_season_id")
  teamId         String   @map("team_id")
  createdAt      DateTime @default(now()) @map("created_at")

  leagueSeason LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([leagueSeasonId, teamId])
  @@index([teamId])
  @@map("league_season_teams")
}
