model Prediction {
  id              String   @id @default(uuid())
  fplEvent        Int      @map("fpl_event")
  playerId        String   @map("player_id")
  modelVersion    String   @map("model_version")
  expectedMinutes Float    @map("expected_minutes")
  /// Calibrated expected FPL points for the event.
  expectedPoints  Float    @map("expected_points")
  rawPoints       Float    @map("raw_points")
  components      Json
  createdAt       DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([fplEvent, playerId, modelVersion])
  @@index([fplEvent])
  @@map("predictions")
}

/// One walk-forward check of the model against FPL actual points. The latest row per model version decides whether forecasts are shown.
model ModelEvaluation {
  id               String   @id @default(cuid())
  modelVersion     String   @map("model_version")
  createdAt        DateTime @default(now()) @map("created_at")
  eventsEvaluated  Int      @map("events_evaluated")
  playerEvents     Int      @map("player_events")
  mae              Float
  baselineMae      Float    @map("baseline_mae")
  rankCorr         Float    @map("rank_corr")
  baselineRankCorr Float    @map("baseline_rank_corr")
  passed           Boolean
  details          Json

  @@index([modelVersion, createdAt])
  @@map("model_evaluations")
}

/// Per-match player probabilities for the next horizon (1..5) fixtures.
model MatchProbability {
  id              String   @id @default(uuid())
  modelVersion    String   @map("model_version")
  fixtureId       String   @map("fixture_id")
  playerId        String   @map("player_id")
  horizon         Int
  pGoal           Float    @map("p_goal")
  pAssist         Float    @map("p_assist")
  pStart          Float    @map("p_start")
  expectedMinutes Float    @map("expected_minutes")
  expectedPoints  Float    @map("expected_points")
  /// Four probabilities: 0-2, 3-5, 6-9, 10+ points.
  pointsBuckets   Json     @map("points_buckets")
  createdAt       DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([modelVersion, fixtureId, playerId])
  @@index([playerId])
  @@map("match_probabilities")
}

/// Match outcome probabilities and expected goals of one fixture.
model FixtureProbability {
  id           String   @id @default(uuid())
  modelVersion String   @map("model_version")
  fixtureId    String   @map("fixture_id")
  pHome        Float    @map("p_home")
  pDraw        Float    @map("p_draw")
  pAway        Float    @map("p_away")
  xgHome       Float    @map("xg_home")
  xgAway       Float    @map("xg_away")
  leagueGoals  Float    @map("league_goals")
  createdAt    DateTime @default(now()) @map("created_at")

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([modelVersion, fixtureId])
  @@map("fixture_probabilities")
}
